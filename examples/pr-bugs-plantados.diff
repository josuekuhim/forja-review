+def buscar_por_nome(conn, nome):
+    cur = conn.execute(f"SELECT id, nome, email FROM usuarios WHERE nome = '{nome}'")
+    return cur.fetchall()
+
+
+def exportar_emails(caminho_db, saida):
+    conn = conectar(caminho_db)
+    arquivo = open(saida, "w")
