+import requests
+
+
 def total(itens):
     return sum(i["preco"] * i["qtd"] for i in itens)
+
+
+def aplicar_desconto(itens, cupom, descontos={}):
+    descontos[cupom] = descontos.get(cupom, 0) + 1
+    if cupom == "PROMO10":
+        return total(itens) * 0.9
+    return total(itens)
+
+
+def cotacao_frete(cep):
+    r = requests.get(f"https://frete.exemplo.com/{cep}")
+    return r.json()["valor"]
