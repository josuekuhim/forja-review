# GitHub App (Settings → Developer settings → GitHub Apps). Nunca commite a chave nem o segredo.
FORJA_REVIEW_APP_ID=123456
FORJA_REVIEW_PRIVATE_KEY_PATH=./forja-review.private-key.pem
FORJA_REVIEW_WEBHOOK_SECRET=troque-por-um-segredo-longo

# Modelo: qualquer endpoint OpenAI-compatível. Padrão: o forja-serve local.
FORJA_REVIEW_LLM_BASE_URL=http://127.0.0.1:8000/v1
FORJA_REVIEW_LLM_MODEL=qwen2.5-coder-0.5b
# FORJA_REVIEW_LLM_API_KEY_ENV=OPENROUTER_API_KEY   # nome da variável que guarda a chave, não a chave
# FORJA_REVIEW_LLM_JSON_MODE=1                      # llama.cpp: JSON garantido por gramática
FORJA_REVIEW_LLM_MAX_TOKENS=512

# Armazenamento e telemetria
FORJA_REVIEW_DB=forja-review.sqlite
FORJA_REVIEW_TRACES=traces/spans.jsonl
# FORJA_REVIEW_CAPTURAR_CONTEUDO=0   # repos privados: não grava diff nem resposta nos traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # também exporta por OTLP (uv sync --extra otlp)
# FORJA_REVIEW_IGNORAR=docs/*,*.md   # globs extras a não revisar
